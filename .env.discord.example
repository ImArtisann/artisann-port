# Configuration for the owner-only Discord bot (apps/discord).
#
# Copy to .env.discord (git-ignored, never committed, never in the build
# context) and fill in values on the machine that runs the container:
#
#   cp -n .env.discord.example .env.discord
#
# Required values below are blank on purpose. Do not paste secrets into source,
# examples, commit messages, logs or issue text. The bot reads these variables
# from the process environment only; it never loads the repository's .env.
#
# Local run:  bun run discord      (loads .env.discord explicitly)
# Container:  docker compose -f apps/discord/compose.yaml up -d --build

# --- Discord application ------------------------------------------------------
# Bot token from the Developer Portal. Rotate ("Reset Token") before the first
# live connection and after any suspected exposure; the previously shared token
# must be treated as burned.
DISCORD_BOT_TOKEN=
# Application (client) ID. Verified at startup against rest.getMyApplication().
DISCORD_BOT_CLIENT_ID=
# Guild snowflake the bot is installed in; the only guild it answers.
DISCORD_SERVER_ID=
# Owner/observed-user snowflake; the only user allowed to run commands and the
# user whose presence is published.
DISCORD_USER_ID=

# --- Visitor-note moderation --------------------------------------------------
# Private text channel (inside DISCORD_SERVER_ID) where pending notes arrive.
DISCORD_NOTES_CHANNEL_ID=
# Application-owned webhook that posts the review messages. The ID is verified
# to belong to this application and to the notes channel; the URL is a redacted
# secret used to read and edit those messages. Provision the webhook once with
# the bot application (temporary Manage Webhooks), then remove that permission.
# The same URL is stored separately as a presence Worker secret.
DISCORD_NOTES_WEBHOOK_ID=
DISCORD_NOTES_WEBHOOK_URL=

# --- Presence Worker RPC ------------------------------------------------------
# HTTPS origin of the presence Worker. For local verification only, use an
# explicit-port localhost or 127.0.0.1 HTTP origin (for example,
# http://localhost:1338/). Credentials, query strings, fragments, and paths
# other than the root slash are rejected at startup.
PORTFOLIO_API_URL=
# Shared bearer secret for authenticated writer RPCs. This is the same redacted
# CONTENT_WRITER_TOKEN secret configured on the presence Worker; it is never
# shared with the website frontend.
CONTENT_WRITER_TOKEN=

# --- Public asset settings (optional; defaults are production values) ---------
# Public HTTPS host that serves photo objects. Omit the variable to use
# DEFAULT_ASSETS_HOST (assets.artisann.dev). A bare hostname is validated;
# arbitrary schemes, ports, or paths are rejected at startup.
# ASSETS_HOST=assets.artisann.dev
