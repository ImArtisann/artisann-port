---
import { portfolio } from "@/lib/about-me.ts";
import { portfolioIds } from "./constants.ts";
import ProofRow from "./proof-row.astro";
import ResponsiveCopy from "./responsive-copy.astro";
import SectionFooter from "./section-footer.astro";
import SectionHeader from "./section-header.astro";
import SectionShell from "./section-shell.astro";
import { accentTextClasses, getExternalLinkProps } from "./shared.ts";
---

<SectionShell id={portfolioIds.work} accent="cyan">
  <SectionHeader titleId={portfolioIds.workTitle} copy={portfolio.sectionCopy.work} />
  <div>
    <div
      class="mt-8.25 flex min-w-0 flex-col border-t border-nightfall-border lg:mt-12.75 lg:flex-row lg:flex-wrap lg:border-t-0"
    >
      {
        portfolio.personalProjects.map((project, index) => {
          const recordClasses =
            index === 0
              ? "flex min-w-0 basis-full grow flex-col gap-8 border-b border-nightfall-border bg-nightfall-surface px-5 py-[1.375rem] lg:max-w-[50%] lg:basis-1/2 lg:border-r lg:px-[1.875rem] lg:py-7"
              : "flex min-w-0 basis-full grow flex-col gap-8 border-b border-nightfall-border px-5 py-[1.375rem] lg:max-w-[50%] lg:basis-1/2 lg:border-r lg:px-[1.875rem] lg:py-7";

          return (
            <article class={recordClasses}>
              <div class="flex min-w-0 flex-wrap items-start justify-between gap-x-3 gap-y-2 font-mono text-[0.5625rem] leading-tight font-[650] tracking-[0.05rem] text-nightfall-muted tabular-nums lg:text-[0.625rem] lg:tracking-[0.0625rem]">
                <span class="min-w-0 wrap-break-word font-bold">
                  <span class={accentTextClasses[project.accent]}>
                    <ResponsiveCopy
                      value={{
                        desktop: project.meta.desktopLeft,
                        mobile: project.meta.mobileLeft,
                      }}
                    />
                  </span>
                </span>
                <span class="min-w-0 wrap-break-word text-right">
                  <ResponsiveCopy
                    value={{
                      desktop: project.meta.desktopRight,
                      mobile: project.meta.mobileRight,
                    }}
                  />
                </span>
              </div>
              <div class="flex min-w-0 flex-col gap-3">
                <h3
                  class="min-w-0 wrap-break-word text-[2.25rem] leading-[0.96] font-[650] tracking-[-0.0389em] text-nightfall-text-bright lg:text-[3.125rem] lg:tracking-[-0.044em]"
                >
                  {project.name}
                </h3>
                <p
                  class="min-w-0 wrap-break-word text-sm leading-[1.4] font-[450] text-nightfall-text text-pretty lg:text-base lg:leading-[1.45]"
                >
                  <ResponsiveCopy value={project.description} />
                </p>
              </div>
              <div class="mt-auto flex min-w-0 flex-col gap-3.5">
                <ProofRow accent={project.accent}>{project.proof}</ProofRow>
                <div
                  class="flex min-w-0 flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-[0.5625rem] leading-tight font-[650] tracking-[0.0344rem] text-nightfall-muted tabular-nums lg:tracking-[0.0406rem]"
                >
                  <span class="inline-flex min-h-11 min-w-0 items-center wrap-break-word">
                    {project.technologies.join(" / ")}
                  </span>
                  {
                    project.href ? (
                      <a
                        class={`inline-flex min-h-11 items-center wrap-break-word font-bold transition-colors duration-180 ease-out hover:text-nightfall-cyan ${accentTextClasses[project.accent]}`}
                        href={project.href}
                        {...getExternalLinkProps(project.href)}
                      >
                        <ResponsiveCopy
                          value={{
                            desktop: project.desktopAction,
                            mobile: project.mobileAction,
                          }}
                        />
                      </a>
                    ) : (
                      <span class="inline-flex min-h-11 min-w-0 items-center wrap-break-word">
                        <ResponsiveCopy
                          value={{
                            desktop: project.desktopAction,
                            mobile: project.mobileAction,
                          }}
                        />
                      </span>
                    )
                  }
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
    <SectionFooter
      signature="ARTISANN / SOLO PRODUCTS"
      prompt="BROWSE SELECTED WORK ↗"
      promptHref="#work"
    />
  </div>
</SectionShell>
