---
import { portfolio } from "@/lib/about-me.ts";
import { portfolioIds } from "./constants.ts";
import ResponsiveCopy from "./responsive-copy.astro";
import SectionFooter from "./section-footer.astro";
import SectionShell from "./section-shell.astro";
import { accentBackgroundClasses, accentTextClasses } from "./shared.ts";
---

<SectionShell id={portfolioIds.contact} accent="violet">
  <div class="flex min-w-0 flex-col border-t border-nightfall-border lg:flex-row">
    <article
      class="flex min-w-0 flex-col bg-nightfall-surface p-5 sm:p-6 lg:flex-[1.75] lg:border-r lg:border-nightfall-border lg:px-10 lg:py-9"
    >
      <span
        class={`font-mono text-[0.5625rem] font-bold tracking-[0.05625rem] ${accentTextClasses.violet}`}
      >
        {portfolio.contact.prompt}
      </span>
      <h3
        class="mt-4.25 min-w-0 wrap-break-word text-[2rem] leading-none font-[620] tracking-[-0.0375em] text-nightfall-text-bright lg:text-[3.375rem] lg:tracking-[-0.0407em]"
      >
        <a
          class="contact-cta inline-flex min-h-11 max-w-full items-center wrap-break-word no-underline hover:text-nightfall-cyan"
          href={portfolio.contact.emailHref}
        >
          EMAIL ARTISANN ↗
        </a>
      </h3>
      <span
        class={`mt-2 h-0.75 w-full self-stretch ${accentBackgroundClasses.violet}`}
        aria-hidden="true"
      ></span>
      <p
        class="mt-4.5 min-w-0 max-w-prose wrap-break-word text-sm leading-[1.4] font-[450] text-nightfall-text text-pretty lg:text-[1.1875rem] lg:leading-[1.45]"
      >
        <ResponsiveCopy value={portfolio.contact.detail} />
      </p>
      <div
        class="mt-auto flex min-w-0 flex-wrap justify-between gap-x-4 gap-y-2 pt-6 font-mono text-[0.5rem] font-[650] tracking-[0.04375rem] text-nightfall-muted"
      >
        <span class="min-w-0 wrap-break-word">PERSON TO PERSON</span>
        <span class={`min-w-0 wrap-break-word ${accentTextClasses.violet}`}>
          PRIMARY CONTACT
        </span>
      </div>
    </article>
    <div class="flex min-w-0 flex-1 flex-col">
      {
        portfolio.contact.audiences.map((audience) => (
          <article
            class="flex min-w-0 flex-1 flex-col border-t border-nightfall-border p-4.5 first:border-t-0 lg:px-7.5 lg:py-7"
          >
            <span
              class={`font-mono text-[0.5625rem] font-bold tracking-[0.05rem] ${accentTextClasses[audience.accent]}`}
            >
              {audience.label}
            </span>
            <h3
              class="mt-4 min-w-0 wrap-break-word text-[1.3125rem] leading-[1.12] font-semibold tracking-[-0.019em] text-nightfall-text-bright text-balance lg:text-[1.5625rem] lg:tracking-[-0.02em]"
            >
              {audience.title}
            </h3>
            <p
              class="mt-auto min-w-0 wrap-break-word pt-5 text-[0.8125rem] leading-[1.35] font-[450] text-nightfall-text text-pretty lg:text-[0.9375rem] lg:leading-[1.45]"
            >
              <ResponsiveCopy value={audience.detail} />
            </p>
          </article>
        ))
      }
    </div>
  </div>
  <SectionFooter
    signature="ARTISANN / DEVELOPER + AUTOMATION ARCHITECT"
    prompt="LET’S TALK ↗"
    promptHref={portfolio.contact.emailHref}
    accent="violet"
  />
</SectionShell>
