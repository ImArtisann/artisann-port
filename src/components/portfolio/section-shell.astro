---
import { type AccentName, accentBackgroundClasses, sectionAccentStyles } from "./shared.ts";

interface Props {
  id: string;
  accent: AccentName;
  className?: string;
}

const { id, accent, className = "" } = Astro.props;
---

<section
  id={id}
  class={`relative scroll-mt-0 bg-nightfall-bg ${className}`}
  style={sectionAccentStyles[accent]}
>
  <span
    class={`absolute inset-y-0 left-0 z-3 w-1 ${accentBackgroundClasses[accent]}`}
    aria-hidden="true"
  ></span>
  <div class="relative z-2 mx-auto w-full px-5 pt-12 sm:px-8 lg:px-18 lg:pt-17">
    <slot />
  </div>
</section>
