---
import { type AccentName, accentBackgroundClasses } from "./shared.ts";

interface Props {
  accent: AccentName;
  className?: string;
}

const { accent, className = "" } = Astro.props;
---

<div
  class={`flex min-w-0 items-center gap-3 border-y border-nightfall-border py-3 ${className}`}
>
  <span
    class={`h-6 w-0.75 shrink-0 lg:w-1 ${accentBackgroundClasses[accent]}`}
    aria-hidden="true"
  ></span>
  <span
    class="min-w-0 wrap-break-word font-mono text-[0.5625rem] leading-tight font-bold tracking-[0.040625rem] text-nightfall-text-bright tabular-nums lg:text-[0.625rem] lg:tracking-[0.04375rem]"
  >
    <slot />
  </span>
</div>
