---
import ResponsiveCopy from "./responsive-copy.astro";
import { getExternalLinkProps, type LinkValue } from "./shared.ts";

interface Props {
  link: LinkValue;
  className?: string;
}

const { link, className = "" } = Astro.props;
const value = { desktop: link.desktopLabel, mobile: link.mobileLabel };
---

{
  link.href ? (
    <a class={className} href={link.href} {...getExternalLinkProps(link.href)}>
      <ResponsiveCopy value={value} />
    </a>
  ) : (
    <span class={className}>
      <ResponsiveCopy value={value} />
    </span>
  )
}
