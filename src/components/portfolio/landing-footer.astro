---
import { portfolio } from "@/lib/about-me.ts";
import PortfolioLinkText from "./portfolio-link-text.astro";
import { accentBackgroundClasses, accentTextClasses } from "./shared.ts";
---

<footer class="relative bg-nightfall-bg px-5 py-5 sm:px-8 lg:px-18 lg:py-18">
  <span
    class={`absolute inset-y-0 left-0 z-3 w-1 ${accentBackgroundClasses.peach}`}
    aria-hidden="true"
  ></span>
  <div class="relative z-2 mx-auto flex w-full min-w-0 max-w-360 flex-col lg:flex-row">
    <nav
      class="flex min-w-0 flex-1 flex-col gap-2.5 border-b border-nightfall-border px-4.5 py-5 lg:border-r lg:border-b-0 lg:px-7 lg:py-6"
      aria-label="Explore portfolio"
    >
      <h2
        class={`font-mono text-[0.5rem] font-bold tracking-[0.05rem] ${accentTextClasses.cyan}`}
      >
        EXPLORE
      </h2>
      <div class="flex min-w-0 flex-col gap-2">
        {
          portfolio.footer.explore.map((link) => (
            <PortfolioLinkText
              link={link}
              className="inline-flex min-h-11 min-w-0 items-center wrap-break-word text-sm leading-tight font-[560] text-nightfall-text-bright no-underline transition-colors duration-180 ease-out hover:text-nightfall-cyan lg:text-base"
            />
          ))
        }
      </div>
    </nav>
    <nav
      class="flex min-w-0 flex-1 flex-col gap-2.5 px-4.5 py-5 lg:px-7 lg:py-6"
      aria-label="Elsewhere"
    >
      <h2
        class={`font-mono text-[0.5rem] font-bold tracking-[0.05rem] ${accentTextClasses.cyan}`}
      >
        ELSEWHERE
      </h2>
      <div class="flex min-w-0 flex-wrap gap-x-5.5 gap-y-2">
        {
          portfolio.footer.elsewhere.map((link) => (
            <PortfolioLinkText
              link={link}
              className="inline-flex min-h-11 min-w-0 items-center wrap-break-word text-sm leading-tight font-[560] text-nightfall-text-bright no-underline transition-colors duration-180 ease-out hover:text-nightfall-cyan lg:text-base"
            />
          ))
        }
      </div>
    </nav>
  </div>
</footer>
