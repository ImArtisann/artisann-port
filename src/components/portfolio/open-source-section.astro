---
import { portfolio } from "@/lib/about-me.ts";
import { portfolioIds } from "./constants.ts";
import ResponsiveCopy from "./responsive-copy.astro";
import SectionFooter from "./section-footer.astro";
import SectionHeader from "./section-header.astro";
import SectionShell from "./section-shell.astro";
import { accentTextClasses, getExternalLinkProps } from "./shared.ts";
---

<SectionShell id={portfolioIds.openSource} accent="cyan">
  <SectionHeader titleId={portfolioIds.openSourceTitle} copy={portfolio.sectionCopy.openSource} />
  <div class="mt-7 flex min-w-0 flex-col border-t border-nightfall-border lg:mt-13">
    {
      portfolio.openSourceProjects.map((project, index) => (
        <article class="flex min-w-0 flex-wrap border-b border-nightfall-border lg:flex-nowrap">
          <div
            class={`flex shrink-0 flex-col gap-2.5 border-r border-nightfall-border p-4 font-mono text-[0.5625rem] font-bold tracking-[0.05rem] tabular-nums lg:gap-4.5 lg:p-6 lg:text-xs lg:tracking-[0.0625rem] ${accentTextClasses[project.accent]}`}
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>
          <div
            class="flex min-w-0 flex-1 flex-col p-4 sm:p-4.5 lg:basis-0 lg:flex-[1.1] lg:p-6 lg:pr-7"
          >
            <div class="flex min-w-0 items-start justify-between gap-3">
              <h3
                class="min-w-0 wrap-break-word text-[1.625rem] leading-[1.05] font-semibold tracking-[-0.0269em] text-nightfall-text-bright text-balance lg:text-[1.875rem] lg:tracking-[-0.0333em]"
              >
                {project.name}
              </h3>
              <a
                class={`inline-flex size-11 shrink-0 items-start justify-end text-lg leading-none font-medium no-underline transition-colors duration-180 ease-out hover:text-nightfall-cyan lg:text-[1.375rem] ${accentTextClasses[project.accent]}`}
                href={project.href}
                {...getExternalLinkProps(project.href)}
                aria-label={`View ${project.name} repository`}
              >
                ↗
              </a>
            </div>
            <p
              class="mt-3 min-w-0 wrap-break-word text-sm leading-[1.4] font-[450] text-nightfall-text text-pretty lg:leading-[1.45]"
            >
              <ResponsiveCopy value={project.description} />
            </p>
            <a
              class={`mt-auto inline-flex min-h-11 items-end text-[0.5rem] font-bold tracking-[0.05rem] no-underline transition-colors duration-180 ease-out hover:text-nightfall-cyan lg:hidden ${accentTextClasses[project.accent]}`}
              href={project.href}
              {...getExternalLinkProps(project.href)}
            >
              VIEW REPOSITORY ↗
            </a>
          </div>
          <div
            class="basis-full border-t border-nightfall-border px-4.5 py-4 lg:min-w-0 lg:basis-0 lg:flex-1 lg:border-t-0 lg:border-l lg:px-6 lg:py-3.5"
          >
            <p
              class={`mb-3 font-mono text-[0.5625rem] leading-[1.35] font-bold tracking-[0.05rem] ${accentTextClasses.green}`}
            >
              TECHNOLOGY STACK
            </p>
            <div class="flex min-w-0 flex-col">
              {project.technologies.map((technology, technologyIndex) => (
                <div
                  class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 border-t border-nightfall-border py-2.5 lg:py-3"
                >
                  <span
                    class={`shrink-0 font-mono text-[0.5625rem] font-bold tracking-[0.05rem] tabular-nums ${accentTextClasses[project.accent]}`}
                  >
                    {String(technologyIndex + 1).padStart(2, "0")}
                  </span>
                  <span
                    class="min-w-0 flex-1 wrap-break-word text-sm leading-tight font-semibold text-nightfall-text-bright lg:text-[0.9375rem]"
                  >
                    {technology.name}
                  </span>
                  <span
                    class="min-w-0 wrap-break-word font-mono text-[0.5rem] leading-[1.35] font-bold tracking-[0.04375rem] text-nightfall-muted"
                  >
                    {technology.role}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
  <SectionFooter
    signature="ARTISANN / OPEN SOURCE 2026"
    prompt="CONTACT ↓"
    promptHref="#contact"
  />
</SectionShell>
