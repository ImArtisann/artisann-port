{
    "name": "artisann-portfolio",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vp run dev:all",
        "dev:web": "bun --no-env-file run --cwd apps/web dev",
        "dev:cats": "alchemy dev apps/jakes-cats/alchemy.run.ts",
        "discord": "bun --no-env-file --env-file=.env.discord apps/discord/src/main.ts",
        "preview": "bun run --cwd apps/web preview",
        "login": "alchemy login stacks/github.ts --profile admin --configure",
        "plan": "alchemy plan alchemy.run.ts",
        "deploy": "vp run deploy:all",
        "deploy:website": "alchemy deploy alchemy.run.ts --stage prod",
        "deploy:cats": "alchemy deploy apps/jakes-cats/alchemy.run.ts --stage prod",
        "destroy": "alchemy destroy",
        "check": "bun run --cwd apps/web check && vp check",
        "format": "vp fmt",
        "lint": "vp lint",
        "test": "vp test",
        "build": "vp run -r build",
        "deploy:github": "alchemy deploy stacks/github.ts --profile admin",
        "deploy:presence": "alchemy deploy packages/presence/alchemy.run.ts --stage prod",
        "prepare": "lefthook install && effect-tsgo patch --typescript --oxlint"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "catalog": {
        "alchemy": "2.0.0-beta.83",
        "effect": "4.0.5",
        "@effect/platform-bun": "4.0.5",
        "@effect/platform-node": "4.0.5",
        "@types/bun": "^1.4.3",
        "lefthook": "^2.2.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@hugeicons-pro/core-solid-rounded": "^4.3.4",
        "@hugeicons/react": "^1.1.10",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "@base-ui/react": "^1.9.0",
        "shadcn": "^4.22.0",
        "tw-animate-css": "^1.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "tailwindcss": "^4.3.3",
        "aws4fetch": "^1.0.20",
        "image-size": "^2.0.4",
        "@unpic/react": "^1.0.2",
        "@unpic/astro": "^1.0.2",
        "astro": "^7.4.0",
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.83",
        "@tanstack/react-router": "^1.170.45",
        "@tanstack/react-start": "^1.169.3",
        "@vitejs/plugin-react": "^6.1.2",
        "vite": "^8.3.4",
        "@cloudflare/workers-types": "^5.20261016.1",
        "motion": "^14.3.0"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "catalog:",
        "@effect/platform-bun": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/tsgo": "0.53.3",
        "@oxlint/plugins": "1.88.0",
        "@artisann-port/typescript-config": "workspace:*",
        "@types/bun": "catalog:",
        "alchemy": "catalog:",
        "effect": "catalog:",
        "lefthook": "catalog:",
        "typescript": "7.0.2",
        "vite-plus": "1.3.0"
    }
}
