{
    "name": "artisann-portfolio",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run --cwd apps/web dev",
        "preview": "bun run --cwd apps/web preview",
        "login": "alchemy login stacks/github.ts --profile admin --configure",
        "plan": "alchemy plan alchemy.run.ts",
        "deploy": "alchemy deploy alchemy.run.ts --stage prod",
        "destroy": "alchemy destroy",
        "check": "vp check && bun run --cwd apps/web check",
        "format": "vp fmt",
        "lint": "vp lint",
        "test": "vp test",
        "build": "vp run -r build",
        "deploy:github": "alchemy deploy stacks/github.ts --profile admin",
        "prepare": "lefthook install && effect-tsgo patch --typescript --oxlint"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "catalog": {
        "alchemy": "2.0.0-beta.76",
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112",
        "@types/bun": "^1.4.1",
        "lefthook": "^2.1.12",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@fontsource-variable/geist": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.2.6",
        "lucide-react": "^1.42.0",
        "@base-ui/react": "^1.8.0",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "tailwindcss": "^4.3.3",
        "aws4fetch": "^1.0.20",
        "image-size": "^2.0.2",
        "@unpic/react": "^1.0.2",
        "@unpic/astro": "^1.0.2",
        "astro": "^7.3.1",
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.76"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "catalog:",
        "@effect/platform-bun": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/tsgo": "0.41.0",
        "@oxlint/plugins": "1.79.0",
        "@repo/typescript-config": "workspace:*",
        "@types/bun": "catalog:",
        "alchemy": "catalog:",
        "effect": "catalog:",
        "lefthook": "catalog:",
        "typescript": "7.0.2",
        "vite-plus": "0.3.0"
    }
}
