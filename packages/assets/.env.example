# Copy this file to .env in packages/assets. Never commit .env.
# ASSETS_BUCKET_NAME and ASSETS_HOST fall back to the constants in src/config.ts;
# set them only to point a stage at a different bucket or domain.
ASSETS_BUCKET_NAME=artisann-portfolio-assets
ASSETS_HOST=assets.artisann.dev
# Cloudflare zone that owns ASSETS_HOST. Required by `bun run deploy`.
ASSETS_ZONE_ID=

# Upload credentials, in precedence order. Both are optional for
# `bun run upload:plan`, and exactly one set is needed for `bun run upload`.
#
# 1. R2 S3 API credentials, scoped to read/write objects in this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 2. The account token the Alchemy stacks already deploy with; needs the
#    "Workers R2 Storage: Edit" permission. Usually inherited from the repo root.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
