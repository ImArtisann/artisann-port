---
import { type AccentName, accentTextClasses } from "./shared.ts";

interface Props {
  signature: string;
  prompt: string;
  promptHref?: string;
  accent?: AccentName;
}

const { signature, prompt, promptHref, accent = "cyan" } = Astro.props;
const promptClass = `inline-flex min-h-11 min-w-11 items-center justify-end text-right font-bold transition-colors duration-[180ms] ease-out hover:text-nightfall-cyan ${accentTextClasses[accent]}`;
---

<footer
  class="mt-8 flex min-h-11 min-w-0 flex-wrap items-center justify-between gap-x-5 gap-y-2 border-t border-nightfall-border font-mono text-[0.5rem] font-[650] tracking-[0.04375rem] text-nightfall-muted tabular-nums lg:mt-10 lg:text-[0.5625rem] lg:tracking-[0.05rem]"
>
  <span class="min-w-0 wrap-break-word">{signature}</span>
  {
    promptHref ? (
      <a class={promptClass} href={promptHref}>
        {prompt}
      </a>
    ) : (
      <span class={promptClass}>{prompt}</span>
    )
  }
</footer>
