---
import type { portfolio } from "@/lib/about-me.ts";
import ProofRow from "./proof-row.astro";
import ResponsiveCopy from "./responsive-copy.astro";
import { accentTextClasses } from "./shared.ts";

interface Props {
  experience: (typeof portfolio.workExperiences)[number];
  primary?: boolean;
}

const { experience, primary = false } = Astro.props;
const recordClasses = primary
  ? "flex min-w-0 flex-col gap-8 border-b border-nightfall-border bg-nightfall-surface px-5 py-[1.375rem] lg:flex-[1.6] lg:border-r lg:border-b-0 lg:px-[2.125rem] lg:py-8"
  : "flex min-w-0 flex-1 flex-col gap-8 border-b border-nightfall-border px-5 py-[1.375rem] lg:px-[1.875rem] lg:py-7";
const headingClasses = primary
  ? "min-w-0 break-words text-[2.625rem] leading-[0.96] font-[650] tracking-[-0.0405em] text-nightfall-text-bright lg:text-[4rem] lg:tracking-[-0.04375em]"
  : "min-w-0 break-words text-[2.25rem] leading-[0.96] font-[650] tracking-[-0.0472em] text-nightfall-text-bright lg:text-[2.375rem] lg:tracking-[-0.0368em]";
---

<article class={recordClasses}>
  <div
    class="flex min-w-0 flex-wrap items-start justify-between gap-x-3 gap-y-2 font-mono text-[0.5625rem] leading-tight font-[650] tracking-[0.05rem] text-nightfall-muted tabular-nums lg:text-[0.625rem] lg:tracking-[0.0625rem]"
  >
    <span class="min-w-0 wrap-break-word font-bold text-(--section-accent,var(--nightfall-muted))">
      <ResponsiveCopy
        value={{ desktop: experience.meta.desktopLeft, mobile: experience.meta.mobileLeft }}
      />
    </span>
    <span class="min-w-0 wrap-break-word text-right">
      <ResponsiveCopy
        value={{ desktop: experience.meta.desktopRight, mobile: experience.meta.mobileRight }}
      />
    </span>
  </div>
  <div class="flex min-w-0 flex-col gap-2">
    <h3 class={headingClasses}>{experience.company}</h3>
    <p
      class="min-w-0 wrap-break-word text-sm leading-[1.3] font-semibold text-nightfall-text lg:text-[0.9375rem]"
    >
      {experience.role}
    </p>
    <p
      class={primary
        ? "min-w-0 max-w-prose wrap-break-word text-sm leading-[1.4] font-[450] text-nightfall-text text-pretty lg:text-[1.0625rem] lg:leading-normal"
        : "min-w-0 wrap-break-word text-sm leading-[1.4] font-[450] text-nightfall-text text-pretty lg:leading-[1.45]"}
    >
      <ResponsiveCopy value={experience.description} />
    </p>
  </div>
  <div class="mt-auto flex min-w-0 flex-col gap-3.5">
    <ProofRow accent={experience.accent}>
      <ResponsiveCopy value={experience.proof} />
    </ProofRow>
    <div
      class="flex min-w-0 flex-wrap items-end justify-between gap-x-4 gap-y-2 font-mono text-[0.5625rem] leading-tight font-[650] tracking-[0.0344rem] text-nightfall-muted tabular-nums lg:text-[0.5625rem] lg:tracking-[0.0406rem]"
    >
      <span class="min-w-0 wrap-break-word">
        <ResponsiveCopy value={experience.technologyLabel} />
      </span>
      {
        experience.focus ? (
          <span class="min-w-0 wrap-break-word">
            <span class={accentTextClasses[experience.accent]}>{experience.focus}</span>
          </span>
        ) : null
      }
    </div>
  </div>
</article>
