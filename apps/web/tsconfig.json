{
    "extends": "@artisann-port/typescript-config/base.json",
    "include": ["src/**/*.ts", "__tests__/**/*.ts", "vite.config.ts"],
    "exclude": ["dist", "node_modules"],
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"],
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedSideEffectImports": true,
        "paths": { "@/*": ["./src/*"] }
    }
}
