# Copy these public values into this app's .env. Never put R2 credentials here.
PUBLIC_ASSETS_HOST=
# Enable only after turning on Cloudflare Image Transformations for the domain.
PUBLIC_ASSETS_TRANSFORM=false

# Read-only build-time content source and local development proxy target.
# Browser requests use the website's own origin and its PORTFOLIO service binding.
PUBLIC_PORTFOLIO_API_URL=https://presence.artisann.dev

# Both values are required before the note composer can submit.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_NOTES_COMPOSER=disabled

# The analytics script is omitted when this public site key is blank.
TRAKS_SITE_KEY=
